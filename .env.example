# ==========================================================
# Orvia — Environment Configuration Template
# Duplicate this file to .env and configure your values.
# ==========================================================

# Database
# PostgreSQL connection string (supports Neon, Supabase, RDS, local)
DATABASE_URL=postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require

# Application Environment (development | staging | production)
ENVIRONMENT=development
DEBUG=true

# Security & Secrets
SECRET_KEY=your-random-32-character-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins (comma-separated or JSON list)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend public API endpoint
NEXT_PUBLIC_API_URL=http://localhost:8000
